# Ambiente da API do LetsSign. Copie para `.env` e ajuste se precisar.
# Os valores abaixo já funcionam com o docker-compose da raiz.

NODE_ENV=development
PORT=3020

DATABASE_URL=postgresql://letssign:letssign@localhost:5452/letssign
REDIS_URL=redis://localhost:6392

# Onde o SPA roda — CORS, checagem de origem e links dos e-mails.
CORS_ORIGINS=http://localhost:5190
APP_URL=http://localhost:5190

# Mailpit (caixa de entrada em http://localhost:8035). Sem SMTP_URL, os e-mails só vão para o log.
SMTP_URL=smtp://localhost:1035
EMAIL_REMETENTE=LetsSign <nao-responda@letssign.dev>

DIRETORIO_DE_ARMAZENAMENTO=./storage

# 🔐 Cifra de campo em repouso (CPF, segredo de MFA). Gere com: openssl rand -hex 32
# ⚠️ O valor abaixo é SÓ para desenvolvimento local. Nunca use em produção.
ENCRYPTION_KEY=6c6574737369676e2d6465762d6b65792d6e616f2d7573652d656d2d70726f64

# 🔐 Chave Ed25519 da plataforma (PEM PKCS#8 em base64). Opcional fora de produção:
# sem ela, uma chave é gerada em storage/chaves/ na primeira subida.
# CHAVE_PRIVADA_ED25519=

LOG_LEVEL=info
WORKER_EMBUTIDO=true
