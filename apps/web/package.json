    "@mediapipe/tasks-vision": "^0.10.22",
    "@tanstack/react-query": "^5.102.8",
    "@vladmandic/face-api": "^1.7.15",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "react-pdf": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4"
